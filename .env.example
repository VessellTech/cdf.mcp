# URL pública deste serviço depois do deploy. Defina explicitamente, pois ela
# entra nos metadados OAuth.
PUBLIC_URL=http://localhost:8090
PORT=8090

# URL da API pública do CDF Finance (a mesma usada pelo app). O MCP só fala HTTP.
BACKEND_API_URL=https://api.example.com

# Banco Postgres dedicado a este serviço (não é o banco da API).
DATABASE_URL=postgres://user:pass@localhost:5432/cdf_mcp

# Chave simétrica (32 bytes, base64) usada para criptografar os tokens da
# sessão em repouso. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Segredo usado para assinar cookies de sessão do fluxo /authorize (login form).
SESSION_SECRET=

# Token temporário para verificação de domínio do OpenAI Apps/Plugins.
# O portal mostra um valor único; publique-o em /.well-known/openai-apps-challenge.
OPENAI_APPS_CHALLENGE_TOKEN=

# Origem(ns) permitidas para o client MCP renderizar a tela de login (CORS do /authorize).
ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com

# Modo serviço-a-serviço (backend → MCP): segredo compartilhado que permite a
# outro serviço interno chamar tools do catálogo via HTTP com
# `Authorization: Bearer <este token>` + `X-CDF-User-Token: <JWT do usuário>`.
# Gere com: openssl rand -hex 32
# Se não for definido, o modo serviço fica desabilitado (só OAuth).
MCP_SERVICE_TOKEN=
