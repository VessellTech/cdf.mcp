# URL pública deste serviço quando deployado (Railway injeta RAILWAY_PUBLIC_DOMAIN,
# mas defina explicitamente para gerar as URLs corretas nos metadados OAuth).
PUBLIC_URL=http://localhost:8090
PORT=8090

# API pública do backend-husk (mesma que o app mobile usa). O MCP nunca importa
# código do backend-husk — só fala HTTP, exatamente como o app.
BACKEND_API_URL=https://api.vessell.app

# Postgres isolado deste serviço (Railway addon próprio — NÃO o banco do backend-husk).
DATABASE_URL=postgres://user:pass@localhost:5432/cdf_mcp

# Chave simétrica (32 bytes, base64) usada para criptografar o access/refresh
# token mobile do backend-husk em repouso. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Segredo usado para assinar cookies de sessão do fluxo /authorize (login form).
SESSION_SECRET=

# Token temporário para verificação de domínio do OpenAI Apps/Plugins.
# O portal mostra um valor único; publique-o em /.well-known/openai-apps-challenge.
OPENAI_APPS_CHALLENGE_TOKEN=

# Origem(ns) permitidas para o client MCP renderizar a tela de login (CORS do /authorize).
ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com

# Modo serviço-a-serviço (backend-husk → MCP): segredo compartilhado que
# permite ao backend chamar tools do catálogo via HTTP com
# `Authorization: Bearer <este token>` + `X-CDF-User-Token: <JWT mobile>`.
# Gere com: openssl rand -hex 32
# Se não for definido, o modo serviço fica desabilitado (só OAuth).
MCP_SERVICE_TOKEN=
